{
  "name": "ndr",
  "version": "1.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Capture and resolution tooling for nested decision records.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jdh313/ndr.git"
  },
  "homepage": "https://github.com/jdh313/ndr#readme",
  "bugs": {
    "url": "https://github.com/jdh313/ndr/issues"
  },
  "bin": {
    "ndr": "./src/cli/bin.ts"
  },
  "type": "module",
  "scripts": {
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt src",
    "format:check": "oxfmt --check src",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun build --compile src/cli/bin.ts --outfile dist/ndr",
    "install:bin": "bun run build && ln -sf \"$PWD/dist/ndr\" ~/.local/bin/ndr",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/bun": "^1.3.14",
    "oxfmt": "^0.53.0",
    "oxlint": "^1.68.0",
    "typescript": "^6.0.3"
  }
}

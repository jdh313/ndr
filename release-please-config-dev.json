{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "packages": {
    ".": {
      "versioning": "prerelease",
      "prerelease": true,
      "prerelease-type": "beta",
      "changelog-path": "CHANGELOG-beta.md",
      "extra-files": [
        {
          "type": "json",
          "path": "plugins/ndr/.claude-plugin/plugin.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "plugins/ndr/.codex-plugin/plugin.json",
          "jsonpath": "$.version"
        }
      ]
    }
  }
}
